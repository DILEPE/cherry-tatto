      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst data = raw.body || raw;\n\nconst serviceDate = new Date(String(data.service_date).replace(' ', 'T'));\n\nfunction addMonths(date, months) {\n  const d = new Date(date);\n  d.setMonth(d.getMonth() + months);\n  const y = d.getFullYear();\n  const m = String(d.getMonth() + 1).padStart(2, '0');\n  const day = String(d.getDate()).padStart(2, '0');\n  return `${y}-${m}-${day}`;\n}\n\nconst schedules = data.service_type === 'piercing'\n  ? [\n      { months: 1, label: 'primer control' },\n      { months: 2, label: 'segundo control' },\n      { months: 3, label: 'tercer control' },\n      { months: 4, label: 'cuarto control' },\n    ]\n  : [\n      { months: 2, label: 'dos meses' },\n      { months: 4, label: 'cuatro meses' },\n    ];\n\nreturn schedules.map((item) => ({\n  json: {\n    customer_id: data.customer_id,\n    customer_name: data.customer_name,\n    phone: data.phone,\n    service_type: data.service_type,\n    service_date: data.service_date,\n    reminder_date: addMonths(serviceDate, item.months),\n    control_label: item.label,\n    status: 'pending',\n  },\n}));\n"
      },
